rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isAllowedFinancialCollection(collectionName) {
      return collectionName in [
        'accounts',
        'transactions',
        'budgets',
        'loans',
        'emi_payments',
        'savings_goals',
        'investments',
        'shopping_lists',
        'shopping_items',
        'shopping_shop_prices',
        'categories',
        'currencies',
        'app_settings'
      ];
    }

    function isValidPrivateProfile(uid) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'uid',
          'cloudSyncEnabled',
          'driveBackupEnabled',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'cloudSyncEnabled',
          'driveBackupEnabled',
          'driveWifiOnly',
          'deviceId',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == uid
        && data.cloudSyncEnabled is bool
        && data.driveBackupEnabled is bool
        && (!('driveWifiOnly' in data) || data.driveWifiOnly is bool)
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 160))
        && (!('deviceId' in data) || isValidNonEmptyString(data.deviceId, 128))
        && data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 10
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidPrivateProfileUpdate(uid) {
      return isValidPrivateProfile(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'displayName',
          'cloudSyncEnabled',
          'driveBackupEnabled',
          'driveWifiOnly',
          'deviceId',
          'schemaVersion',
          'updatedAt'
        ]);
    }

    function isValidRecoveryMetadata(uid) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'ownerUid',
          'version',
          'kdfAlgorithm',
          'kdfIterations',
          'saltBase64',
          'wrappedDekBase64',
          'nonceBase64',
          'keyCheckHash',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'version',
          'kdfAlgorithm',
          'kdfIterations',
          'saltBase64',
          'wrappedDekBase64',
          'nonceBase64',
          'keyCheckHash',
          'deviceId',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid == uid
        && data.version is int && data.version >= 1 && data.version <= 10
        && data.kdfAlgorithm == 'PBKDF2WithHmacSHA256'
        && data.kdfIterations is int && data.kdfIterations >= 210000 && data.kdfIterations <= 1000000
        && isValidNonEmptyString(data.saltBase64, 128)
        && isValidNonEmptyString(data.wrappedDekBase64, 512)
        && isValidNonEmptyString(data.nonceBase64, 64)
        && isValidNonEmptyString(data.keyCheckHash, 128)
        && (!('deviceId' in data) || isValidNonEmptyString(data.deviceId, 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidRecoveryMetadataUpdate(uid) {
      return isValidRecoveryMetadata(uid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'version',
          'kdfAlgorithm',
          'kdfIterations',
          'saltBase64',
          'wrappedDekBase64',
          'nonceBase64',
          'keyCheckHash',
          'deviceId',
          'updatedAt'
        ]);
    }

    function isValidEncryptedRecord(uid, recordId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'recordId',
          'ownerUid',
          'entityType',
          'encryptedPayloadBase64',
          'payloadNonceBase64',
          'schemaVersion',
          'syncVersion',
          'updatedByDeviceId',
          'isDeleted',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'recordId',
          'ownerUid',
          'entityType',
          'encryptedPayloadBase64',
          'payloadNonceBase64',
          'schemaVersion',
          'syncVersion',
          'updatedByDeviceId',
          'isDeleted',
          'clientUpdatedAtMillis',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid == uid
        && data.recordId == recordId
        && isValidNonEmptyString(data.entityType, 64)
        && isValidNonEmptyString(data.encryptedPayloadBase64, 524288)
        && isValidNonEmptyString(data.payloadNonceBase64, 64)
        && data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 20
        && data.syncVersion is int && data.syncVersion >= 1
        && isValidNonEmptyString(data.updatedByDeviceId, 128)
        && data.isDeleted is bool
        && (!('clientUpdatedAtMillis' in data) || data.clientUpdatedAtMillis is int)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidEncryptedRecordUpdate(uid, recordId) {
      return isValidEncryptedRecord(uid, recordId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.recordId == resource.data.recordId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.syncVersion > resource.data.syncVersion
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'entityType',
          'encryptedPayloadBase64',
          'payloadNonceBase64',
          'schemaVersion',
          'syncVersion',
          'updatedByDeviceId',
          'isDeleted',
          'clientUpdatedAtMillis',
          'updatedAt'
        ]);
    }

    match /users/{uid}/private/profile {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidPrivateProfile(uid);
      allow update: if isOwner(uid) && isValidPrivateProfileUpdate(uid);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/crypto_metadata/recovery {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidRecoveryMetadata(uid);
      allow update: if isOwner(uid) && isValidRecoveryMetadataUpdate(uid);
      allow delete: if false;
    }

    match /users/{uid}/{collectionName}/{recordId} {
      allow read: if isOwner(uid) && isAllowedFinancialCollection(collectionName);
      allow create: if isOwner(uid)
        && isAllowedFinancialCollection(collectionName)
        && isValidEncryptedRecord(uid, recordId);
      allow update: if isOwner(uid)
        && isAllowedFinancialCollection(collectionName)
        && isValidEncryptedRecordUpdate(uid, recordId);
      allow delete: if isOwner(uid) && isAllowedFinancialCollection(collectionName);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
